# Copy to .env and fill in. Only DISCORD_TOKEN and MONGO_URI are required to boot.

# ---------------------------------------------------------------- required
DISCORD_TOKEN=
MONGO_URI=

# ---------------------------------------------------------------- features
# Waifu gacha. Get a client id from https://myanimelist.net/apiconfig.
# Only the id is needed: the bot reads public character data, which does not use
# the OAuth flow the client secret is for.
MAL_CLIENT_ID=

# AI-generated /story. Get a key from https://openrouter.ai/keys. Without one,
# /story falls back to a built-in story instead of failing.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# ---------------------------------------------------------------- music
# Lavalink node the bot connects to. Must match lavalink/application.yml.
LAVALINK_NAME=main
LAVALINK_URL=localhost:2333
LAVALINK_PASSWORD=<generate-a-unique-deployment-secret>
LAVALINK_SECURE=false

# Spotify link resolution. Get these from https://developer.spotify.com/dashboard.
# Read by Lavalink's LavaSrc plugin, not by the bot; see README "Spotify".
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube sign-in. Lavalink prints this token the first time you authorise a
# Google account; paste it back here so it stops asking. Read by
# lavalink/start.sh, not by the bot. See README "YouTube sign-in".
YOUTUBE_REFRESH_TOKEN=

# ---------------------------------------------------------------- economy
# Channel that receives the /steal wipe and /redeem prank audit lines.
# Leave empty to disable.
STEAL_LOG_CHANNEL_ID=
