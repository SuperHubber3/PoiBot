{
  "name": "poibot",
  "version": "2.0.0",
  "description": "poi boop vak",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "concurrently -k -n lavalink,bot -c magenta,cyan \"npm:lavalink\" \"npm:dev:bot\"",
    "start": "concurrently -k -n lavalink,bot -c magenta,cyan \"npm:lavalink\" \"npm:start:bot\"",
    "lavalink": "./lavalink/start.sh",
    "dev:bot": "tsx watch src/index.ts",
    "start:bot": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuperHubber3/PoiBot.git"
  },
  "author": "Zen, Foga",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/SuperHubber3/PoiBot/issues"
  },
  "homepage": "https://github.com/SuperHubber3/PoiBot#readme",
  "dependencies": {
    "@sapphire/decorators": "^6.2.0",
    "@sapphire/framework": "^5.5.0",
    "@sapphire/plugin-i18next": "^8.0.0",
    "@sapphire/utilities": "^3.18.2",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.5",
    "i18next": "^26.3.4",
    "md5": "^2.3.0",
    "moment": "^2.30.1",
    "mongoose": "^6.13.5",
    "node-mcstatus": "^1.2.1",
    "shoukaku": "^4.3.0"
  },
  "devDependencies": {
    "@types/md5": "^2.3.5",
    "@types/node": "^20.16.0",
    "concurrently": "^10.0.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
